{
  "name": "forgepilot",
  "type": "module",
  "displayName": "ForgePilot",
  "description": "ForgePilot - AI Engineering Teammate for VS Code",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.14.0",
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.open",
        "title": "ForgePilot: Open"
      },
      {
        "command": "forgepilot.newChat",
        "title": "ForgePilot: New Chat"
      },
      {
        "command": "forgepilot.clearChat",
        "title": "ForgePilot: Clear Chat"
      },
      {
        "command": "forgepilot.connect",
        "title": "ForgePilot: Connect to TrueForge"
      },
      {
        "command": "forgepilot.setToken",
        "title": "ForgePilot: Set TrueForge Access Token"
      },
      {
        "command": "forgepilot.clearToken",
        "title": "ForgePilot: Clear TrueForge Access Token"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgepilot-sidebar",
          "title": "ForgePilot",
          "icon": "media/icons/forgepilot.svg"
        }
      ]
    },
    "views": {
      "forgepilot-sidebar": [
        {
          "type": "webview",
          "id": "forgepilot.view",
          "name": "ForgePilot",
          "retainContextWhenHidden": true
        }
      ]
    },
    "configuration": {
      "title": "ForgePilot",
      "properties": {
        "forgepilot.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test ./out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/vscode": "1.100.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.185.0"
  }
}
