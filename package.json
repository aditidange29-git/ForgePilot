{
  "name": "forgepilot",
  "displayName": "ForgePilot",
  "description": "ForgePilot - AI Engineering Teammate for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "icon": "media/icons/forgepilot.png",
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.open",
        "title": "ForgePilot: Open"
      },
      {
        "command": "forgepilot.newChat",
        "title": "ForgePilot: New Chat"
      },
      {
        "command": "forgepilot.clearChat",
        "title": "ForgePilot: Clear Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgepilot-sidebar",
          "title": "ForgePilot",
          "icon": "media/icons/forgepilot.svg"
        }
      ]
    },
    "views": {
      "forgepilot-sidebar": [
        {
          "type": "webview",
          "id": "forgepilot.view",
          "name": "ForgePilot",
          "retainContextWhenHidden": true
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
